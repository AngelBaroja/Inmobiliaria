<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F9"
    android:fillViewport="true"
    tools:context=".ui.inmuebles.DetalleInmuebleFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <!-- 1. Imagen de Cabecera (Altura reducida a 250dp) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardImagen"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            app:cardCornerRadius="0dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/ivDetalleImagen"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_gallery"
                    android:background="#E0E0E0" />

                <TextView
                    android:id="@+id/tvDetalleEstado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/rounded_image"
                    android:backgroundTint="#4CAF50"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Disponible"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Card de Información (Alineada justo debajo de la imagen) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInfoPrincipal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardImagen"
            app:strokeWidth="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvDetallePrecio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$ 0.00"
                    android:textColor="@color/white"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvDetalleDireccion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Dirección del inmueble"
                    android:textColor="#5C647C"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvDetallePrecio" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEspecificaciones"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:layout_constraintEnd_toEndOf="@id/cardInfoPrincipal"
            app:layout_constraintStart_toStartOf="@id/cardInfoPrincipal"
            app:layout_constraintTop_toBottomOf="@id/cardInfoPrincipal"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guidelineCenter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.5" />

                <ImageView
                    android:id="@+id/icAmb"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="#ECEFF1"
                    android:padding="4dp"
                    android:src="@android:drawable/ic_menu_gallery"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#607D8B" />

                <TextView
                    android:id="@+id/tvDetalleAmbientes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="0 Ambientes"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/icAmb"
                    app:layout_constraintEnd_toStartOf="@id/guidelineCenter"
                    app:layout_constraintStart_toEndOf="@id/icAmb"
                    app:layout_constraintTop_toTopOf="@id/icAmb" />

                <ImageView
                    android:id="@+id/icSup"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="#ECEFF1"
                    android:padding="4dp"
                    android:src="@android:drawable/ic_menu_send"
                    app:layout_constraintStart_toEndOf="@id/guidelineCenter"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginStart="8dp"
                    app:tint="#607D8B" />

                <TextView
                    android:id="@+id/tvDetalleSuperficie"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="0 m²"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/icSup"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/icSup"
                    app:layout_constraintTop_toTopOf="@id/icSup" />

                <TextView
                    android:id="@+id/tvDetalleTipo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="4dp"
                    android:background="#E3F2FD"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="Tipo"
                    android:textColor="#1976D2"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/guidelineCenter"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/icAmb" />

                <TextView
                    android:id="@+id/tvDetalleUso"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="#E1F5FE"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="Uso"
                    android:textColor="#0288D1"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/tvDetalleTipo"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/guidelineCenter"
                    app:layout_constraintTop_toTopOf="@id/tvDetalleTipo" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardContrato"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:layout_constraintEnd_toEndOf="@id/cardInfoPrincipal"
            app:layout_constraintStart_toStartOf="@id/cardInfoPrincipal"
            app:layout_constraintTop_toBottomOf="@id/cardEspecificaciones"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/lblContrato"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESTADO DEL CONTRATO"
                    android:textColor="#90A4AE"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvDetalleContrato"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Cargando estado..."
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lblContrato" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditarInmueble"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#1976D2"
            android:text="Cambiar disponibilidad"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="18dp"
            app:icon="@android:drawable/ic_popup_sync"
            app:iconGravity="textStart"
            app:layout_constraintEnd_toEndOf="@id/cardInfoPrincipal"
            app:layout_constraintStart_toStartOf="@id/cardInfoPrincipal"
            app:layout_constraintTop_toBottomOf="@id/cardContrato" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>